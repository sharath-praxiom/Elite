<td tEditID="c1r1" style=" background-color:#FFFFFF; bEditID:r3st1; color:#000000; bLabel:main; font-size:12pt; font-family:arial;" aEditID="c1r1" locked="0" >
<![CDATA[<font face="arial"><span style="font-size: 12pt;">Hello,</span></font><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">Please consider {!Contact.FirstName}&nbsp;{!Contact.LastName} for the following:</div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font color="#3333ff"><b>Position:</b></font></div><div style=""><ul style=""><li style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><b>Salesforce Job:&nbsp;</b><a href="https://focusstaff.lightning.force.com//{!AVTRRT__Job_Applicant__c.AVTRRT__Job__c}">{!AVTRRT__Job_Applicant__c.AVTRRT__Job__c}</a><a href="https://focus-staff.my.salesforce.com/{!TRHC__Job_Applicant__c.Job_Id__c}"><br></a></li><li style=""><b style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">VMS:&nbsp;</b><font face="arial">{!AVTRRT__Job_Applicant__c.MSP__c}</font><b style="font-family: arial; font-size: 12pt;">&nbsp;</b></li><li style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><b>VMS Reference:&nbsp;</b>#{!AVTRRT__Job_Applicant__c.Job_Reference_Number__c}</li><li style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><b>Job Title:&nbsp;</b>{!AVTRRT__Job_Applicant__c.Abrv_Job_Title__c}</li><li style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><b>Facility:&nbsp;</b>{!AVTRRT__Job_Applicant__c.AVTRRT__Account_Job__c}</li><li style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><b>Location:&nbsp;</b>&nbsp;{!AVTRRT__Job_Applicant__c.Job_City__c},&nbsp;{!AVTRRT__Job_Applicant__c.Job_State__c}</li><li style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font style="font-size: 12pt;"><b>Candidate SF Link</b>:&nbsp;{!Contact.Link}</font></li></ul></div>]]></td>
</tr>
